# regime-ok: which axpy arm wins in EACH residency band, arms called directly, one process.
#
# WHY. `_axpy_band` (L1<ws<=L3) and `_axpy_dram` (ws>=L3) are two Measure knobs over the same arm set.
# Audit across processes: axpy_band = 4 x6 on galen, 208 x8 on wintermute — STABLE per box, split
# ACROSS boxes. axpy_dram = 4 on galen (6/6) but bimodal on wintermute (7x4, 2x208 in 9 samples), so it
# ships a different kernel roughly one run in four.
#
# Arm codes (simd_kernels.jl:400-407): 4 -> _axpy_unrolled!(Val(4)); 108 -> _axpy_phase!(Val(8), W);
# 208 -> _axpy_phase!(Val(8), W/2) i.e. the narrow 256-bit phase kernel. Zen4 double-pumps 512-bit ops
# over a 256-bit path, so the narrow arm is expected to win there and not on Zen3 (native 256) — that
# is `_double_pumped(_HW)`, which cpuinfo.jl:140 calls "silicon FACTS, not tuned magic".
#
# The residency SPLIT is already Derive (2*n*sizeof(T) >= _L3_BYTES). Only the arm choice is in
# question, so this measures the arms at sizes either side of that boundary.
using PureBLAS, LinearAlgebra
import PureBLAS as P
include(joinpath(@__DIR__, "..", "measure.jl"))
using .Measure
const T = Float64
const W = P._vwidth(T)
println("W=", W, "  L3=", P._L3_BYTES ÷ 1024 ÷ 1024, " MiB  double_pumped=", P._double_pumped(P._HW))
println("DRAM boundary: n >= ", P._L3_BYTES ÷ (2 * sizeof(T)))
println()
println(rpad("n",10), rpad("regime",8), rpad("arm4",12), rpad("arm108",12), rpad("arm208",12), "best")
for n in (30_000, 100_000, 300_000, 1_000_000, 3_000_000)
    band = 2 * n * sizeof(T) >= P._L3_BYTES ? "DRAM" : "band"
    x = randn(T, n); y0 = randn(T, n); a = 1.7
    ref = copy(y0); ref .+= a .* x
    ts = Float64[]
    for (nm, f) in (("a4", (yy, xx) -> GC.@preserve xx yy P._axpy_unrolled!(Val(4), n, a, pointer(xx), pointer(yy), 0)),
                    ("a108", (yy, xx) -> GC.@preserve xx yy P._axpy_phase!(Val(8), Val(W), n, a, pointer(xx), pointer(yy))),
                    ("a208", (yy, xx) -> GC.@preserve xx yy P._axpy_phase!(Val(8), Val(W ÷ 2), n, a, pointer(xx), pointer(yy))))
        yc = copy(y0); f(yc, x)
        e = maximum(abs, yc .- ref) / max(1, maximum(abs, ref))
        e < 1e-12 || println("  !! arm $nm WRONG at n=$n relerr=$e")
        res = Measure.ab(["run" => (c -> (copyto!(c.y, y0); f(c.y, x))), "null" => (c -> c.y)];
                         rounds = 8, setup = () -> (y = copy(y0),), check = c -> true)
        t = Dict(r.name => r.secs * 1e6 for r in res)
        push!(ts, t["run"] - t["null"])
    end
    b = ("4", "108", "208")[argmin(ts)]
    r2(v) = round(v, digits = 2)
    println(rpad(n, 10), rpad(band, 8), rpad(r2(ts[1]), 12), rpad(r2(ts[2]), 12), rpad(r2(ts[3]), 12), b, " (us, lower=better)")
end
