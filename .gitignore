# Julia
Manifest.toml
*.jl.cov
*.jl.*.cov
*.jl.mem
# Machine-local Preferences: the trim build writes ger_panel_np here transiently (juliac/build.jl);
# never ship it — the package's clean default is the runtime auto-calibration.
LocalPreferences.toml
**/LocalPreferences.toml

# Compiled artifacts (juliac --trim output)
*.so
*.dylib
*.dll
juliac/build/

# Documenter / DocumenterVitepress / Node
docs/build/
**/.documenter/
node_modules/
package-lock.json
.vitepress/cache/
.vitepress/dist/

.DS_Store

# Per-host plot data cache (regenerated by bench/plots.jl)
bench/plots_data_*.txt

# Claude Code agent worktrees (embedded git repos — never part of the project)
.claude/worktrees/

# lite-mode plot output: smoke-test artifacts, explicitly NOT gate numbers (see bench/plots.jl)
docs/src/assets/*_lite.svg
bench/archive_v2/

# probe scripts: disposable, but linted (see bench/probes/README.md)
# The `*.jl` rule alone let raw run output accumulate in git — 26 .log files and a .bak, ~1.1 MB of
# July/August probe output with no reader, tracked purely because the pattern did not match them.
bench/probes/*.jl
bench/probes/*.log
bench/probes/*.bak
# EXCEPTION: cited as evidence from a src/ comment (src/blas3/gemm.jl), so it is documentation, not a
# disposable probe. A probe referenced from shipped source must stay tracked or the comment dangles.
!bench/probes/zgemm32_k_scaling.jl
